## 3. Standard Shared SDK Initialization Entry Point

Every enterprise mobile application must bootstrap core enterprise SDKs (Auth, Analytics, Remote Config) during app launch.

<Tabs>
  <TabItem label="Android (Compose)">

```kotlin
// File: Application.kt
package com.enterprise.mobile

import android.app.Application
import com.enterprise.mobile.core.config.AppConfigProvider
import com.enterprise.mobile.core.observability.ObservabilitySDK
import dagger.hilt.android.HiltAndroidApp
import javax.inject.Inject

@HiltAndroidApp
class EnterpriseApplication : Application() {

    @Inject lateinit var appConfigProvider: AppConfigProvider
    @Inject lateinit var observabilitySDK: ObservabilitySDK

    override fun onCreate() {
        super.onCreate()
        
        // 1. Initialize Telemetry & RUM
        observabilitySDK.initialize(
            context = this,
            config = appConfigProvider.currentConfig
        )
    }
}
```

  </TabItem>
  <TabItem label="iOS (SwiftUI)">

```swift
// File: EnterpriseApp.swift
import SwiftUI

@main
struct EnterpriseApp: App {
    @State private var featureFlagManager = FeatureFlagManager()

    init() {
        // 1. Register Custom Typography & Shared Core SDKs
        FontRegistrar.registerFonts()
        ObservabilitySDK.shared.initialize(with: AppConfig.current)
    }

    var body: some Scene {
        WindowGroup {
            MainContentView()
                .environment(featureFlagManager)
                .task {
                    await featureFlagManager.fetchRemoteFlags()
                }
        }
    }
}
```

  </TabItem>
  <TabItem label="React Native (TypeScript)">

```tsx
// File: App.tsx
import React, { useEffect } from 'react';
import { SafeAreaProvider } from 'react-native-safe-area-context';
import { initializeObservability } from './src/core/observability/observabilitySDK';
import { appConfig } from './src/core/config/appConfig';
import { RootNavigator } from './src/navigation/RootNavigator';

export const App: React.FC = () => {
  useEffect(() => {
    // 1. Initialize Telemetry & RUM on App Mount
    initializeObservability(appConfig);
  }, []);

  return (
    <SafeAreaProvider>
      <RootNavigator />
    </SafeAreaProvider>
  );
};
```

  </TabItem>
