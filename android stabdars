// File: src/features/profile/presentation/GreetingHeader.tsx
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';
import { useTranslation } from 'react-i18next';

interface GreetingHeaderProps {
  name: string;
  unreadCount: number;
}

export const GreetingHeader: React.FC<GreetingHeaderProps> = ({ name, unreadCount }) => {
  const { t } = useTranslation();

  return (
    <View style={styles.container}>
      <Text style={styles.greeting}>{t('user_greeting', { name })}</Text>
      <Text style={styles.subtitle}>
        {t('notification_count', { count: unreadCount })}
      </Text>
    </View>
  );
};

const styles = StyleSheet.create({
  container: { padding: 16 },
  greeting: { fontSize: 20, fontWeight: 'bold' },
  subtitle: { fontSize: 14, color: '#666' },
});
