## 1. Color Palette & Theme Tokens

Our color token architecture separates **primitive brand colors** from **semantic functional roles** (Primary, Surface, On-Surface, Error).

<Tabs>
  <TabItem label="Android (Compose)">

```kotlin
// File: core/designsystem/theme/Color.kt
package com.enterprise.mobile.core.designsystem.theme

import androidx.compose.ui.graphics.Color

// Primitive Brand Tokens
val BrandGreenPrimary = Color(0xFF008544)
val BrandGreenDark = Color(0xFF005C2E)
val NeutralLightBackground = Color(0xFFF9FAFB)
val NeutralDarkBackground = Color(0xFF0D1117)
val SignalError = Color(0xFFDC2626)

// File: core/designsystem/theme/Theme.kt
import androidx.compose.material3.*
import androidx.compose.runtime.Composable
import androidx.compose.foundation.isSystemInDarkTheme

private val DarkColorScheme = darkColorScheme(
    primary = BrandGreenPrimary,
    background = NeutralDarkBackground,
    surface = Color(0xFF161B22),
    error = SignalError
)

private val LightColorScheme = lightColorScheme(
    primary = BrandGreenPrimary,
    background = NeutralLightBackground,
    surface = Color.White,
    error = SignalError
)

@Composable
fun EnterpriseTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit
) {
    val colors = if (darkTheme) DarkColorScheme else LightColorScheme
    MaterialTheme(
        colorScheme = colors,
        typography = EnterpriseTypography,
        content = content
    )
}
```

