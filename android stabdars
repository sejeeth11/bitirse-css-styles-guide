## 2. Resource String Catalog Files

String resources must be defined cleanly in standard localization resource files.

<Tabs>
  <TabItem label="Android (Compose)">

```xml
<!-- File: res/values/strings.xml (Default English) -->
<resources>
    <string name="app_name">Enterprise Mobile</string>
    <string name="user_greeting">Hello, %1$s!</string>
    <string name="button_submit">Submit</string>
    <plurals name="notification_count">
        <item quantity="one">You have %d new notification</item>
        <item quantity="other">You have %d new notifications</item>
    </plurals>
</resources>
```

  </TabItem>
  <TabItem label="iOS (SwiftUI)">

```json
// File: Localizable.xcstrings (String Catalog Format)
{
  "sourceLanguage" : "en",
  "strings" : {
    "user_greeting %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hello, %1$@!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Hola, %1$@!" } }
      }
    },
    "button_submit" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Submit" } }
      }
    }
  }
}
```

  </TabItem>
  <TabItem label="React Native (TypeScript)">

```json
// File: src/assets/locales/en.json
{
  "app_name": "Enterprise Mobile",
  "user_greeting": "Hello, {{name}}!",
  "button_submit": "Submit",
  "notification_count_one": "You have {{count}} new notification",
  "notification_count_other": "You have {{count}} new notifications"
}
```

