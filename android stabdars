## 4. UI Asset Component Consumption

Using strongly-typed brand assets safely inside screen components.

<Tabs>
  <TabItem label="Android (Compose)">

```kotlin
// File: feature/branding/ui/BrandHeader.kt
package com.enterprise.mobile.feature.branding.ui

import androidx.compose.foundation.Image
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.size
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.res.painterResource
import androidx.compose.ui.unit.dp
import com.enterprise.mobile.core.designsystem.theme.BrandIcons
import com.enterprise.mobile.core.designsystem.theme.EnterpriseTypography

@Composable
fun BrandHeader(modifier: Modifier = Modifier) {
    Row(modifier = modifier) {
        Image(
            painter = painterResource(id = BrandIcons.AppLogo),
            contentDescription = "Enterprise Brand Logo",
            modifier = Modifier.size(40.dp)
        )
        Text(
            text = "Enterprise Mobile",
            style = EnterpriseTypography.headlineLarge
        )
    }
}
```

