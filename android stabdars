## 3. Complete All-in-One Swift Specification File

Below is the complete, compilation-ready **all-in-one Swift file** (`UserProfileFeature.swift`). It contains the entire stack in one place: DTO, Repository Actor, Domain Struct, Use Case Protocol, `@Observable` ViewModel, and SwiftUI Screen View.

```swift
// File: EnterpriseMobile/Features/User/UserProfileFeature.swift
import SwiftUI
import Observation
import Security

// ============================================================================
// 1. DATA LAYER (DTOs, Mappers & Actor Repository)
// ============================================================================

// Network Transfer DTO
struct UserNetworkDTO: Codable {
    let id: String
    let fullName: String
    let email: String
    let isVip: Bool

    enum CodingKeys: String, CodingKey {
        case id
        case fullName = "full_name"
        case email
        case isVip = "is_vip"
    }
}

// Mapper Extension
extension UserNetworkDTO {
    func toDomainModel() -> UserDomainModel {
        UserDomainModel(
            id: id,
            name: fullName,
            email: email,
            isVip: isVip
        )
    }
}

// Repository Protocol
protocol UserProfileRepositoryProtocol: Sendable {
    func fetchUserProfile(userId: String) async throws -> UserDomainModel
}

// Thread-Safe Actor Repository Implementation
actor UserProfileRepository: UserProfileRepositoryProtocol {
    private let urlSession: URLSession
    private var cache: [String: UserDomainModel] = [:]

    init(urlSession: URLSession = .shared) {
        self.urlSession = urlSession
    }

    func fetchUserProfile(userId: String) async throws -> UserDomainModel {
        // Return thread-safe cached copy if present
        if let cached = cache[userId] {
            return cached
        }

        guard let url = URL(string: "https://api.example.com/v1/users/$userId)") else {
            throw URLError(.badURL)
        }

        let (data, response) = try await urlSession.data(from: url)
        
        guard let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200 else {
            throw URLError(.badServerResponse)
        }

        let dto = try JSONDecoder().decode(UserNetworkDTO.self, from: data)
        let domainModel = dto.toDomainModel()
        
        cache[userId] = domainModel
        return domainModel
    }
}

// ============================================================================
// 2. DOMAIN LAYER (Business Entities & Use Cases)
// ============================================================================

struct UserDomainModel: Equatable, Identifiable, Sendable {
    let id: String
    let name: String
    let email: String
    let isVip: Bool
}

protocol GetUserProfileUseCaseProtocol: Sendable {
    func execute(userId: String) async throws -> UserDomainModel
}

final class GetUserProfileUseCase: GetUserProfileUseCaseProtocol {
    private let repository: UserProfileRepositoryProtocol

    init(repository: UserProfileRepositoryProtocol) {
        self.repository = repository
    }

    func execute(userId: String) async throws -> UserDomainModel {
        guard !userId.trimmingCharacters(in: .whitespaces).isEmpty else {
            throw NSError(domain: "UserProfile", code: 400, userInfo: [NSLocalizedDescriptionKey: "User ID cannot be empty."])
        }
        return try await repository.fetchUserProfile(userId: userId)
    }
}

// ============================================================================
// 3. VIEWMODEL & UI STATE LAYER (Swift 5.9+ @Observable + @MainActor)
// ============================================================================

enum UserProfileUiState: Equatable {
    case loading
    case success(user: UserDomainModel)
    case error(message: String)
}

@Observable
@MainActor
final class UserProfileViewModel {
    private(set) var state: UserProfileUiState = .loading
    private let useCase: GetUserProfileUseCaseProtocol

    init(useCase: GetUserProfileUseCaseProtocol) {
        self.useCase = useCase
    }

    func loadUserProfile(userId: String) async {
        state = .loading
        do {
            let profile = try await useCase.execute(userId: userId)
            state = .success(user: profile)
        } catch {
            state = .error(message: error.localizedDescription)
        }
    }
}

// ============================================================================
// 4. UI LAYER (Declarative SwiftUI Screen View)
// ============================================================================

struct UserProfileScreen: View {
    let userId: String
    @State private var viewModel: UserProfileViewModel
    @Environment(\.dismiss) private var dismiss

    init(userId: String, viewModel: UserProfileViewModel) {
        self.userId = userId
        _viewModel = State(initialValue: viewModel)
    }

    var body: some View {
        NavigationStack {
            Group {
                switch viewModel.state {
                case .loading:
                    ProgressView("Loading Profile...")
                        .tint(Color("BrandGreen"))
                case .success(let user):
                    ProfileDetailsView(user: user) {
                        Task { await viewModel.loadUserProfile(userId: userId) }
                    }
                case .error(let message):
                    VStack(spacing: 12) {
                        Text(message)
                            .foregroundColor(.red)
                            .multilineTextAlignment(.center)
                        Button("Retry") {
                            Task { await viewModel.loadUserProfile(userId: userId) }
                        }
                        .buttonStyle(.borderedProminent)
                        .tint(Color("BrandGreen"))
                    }
                    .padding()
                }
            }
            .navigationTitle("User Profile")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarLeading) {
                    Button(action: { dismiss() }) {
                        Image(systemName: "chevron.left")
                    }
                }
            }
            .task {
                await viewModel.loadUserProfile(userId: userId)
            }
        }
    }
}

private struct ProfileDetailsView: View {
    let user: UserDomainModel
    let onRefresh: () -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text(user.name)
                .font(.title)
                .fontWeight(.bold)

            Text(user.email)
                .font(.body)
                .foregroundColor(.secondary)

            if user.isVip {
                Text("VIP Enterprise Account")
                    .font(.caption)
                    .fontWeight(.bold)
                    .padding(.horizontal, 10)
                    .padding(.vertical, 6)
                    .background(Color("BrandGreen"))
                    .foregroundColor(.white)
                    .cornerRadius(6)
            }

            Spacer()

            Button(action: onRefresh) {
                Text("Refresh User Profile")
                    .fontWeight(.semibold)
                    .frame(maxWidth: .infinity)
                    .padding()
                    .background(Color("BrandGreen"))
                    .foregroundColor(.white)
                    .cornerRadius(10)
            }
        }
        .padding(24)
    }
}

// Previews
#Preview("Success State") {
    UserProfileScreen(
        userId: "usr_100",
        viewModel: UserProfileViewModel(
            useCase: MockGetUserProfileUseCase()
        )
    )
}

// Mock Implementation for SwiftUI Preview
private final class MockGetUserProfileUseCase: GetUserProfileUseCaseProtocol {
    func execute(userId: String) async throws -> UserDomainModel {
        UserDomainModel(id: "usr_100", name: "Alex Mercer", email: "alex.mercer@example.com", isVip: true)
    }
}
