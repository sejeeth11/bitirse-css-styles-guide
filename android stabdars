## 3. Remote Feature Flag Manager

Feature flags allow runtime evaluation of experimental features, emergency kill switches, and gradual percentage rollouts.

<Tabs>
  <TabItem label="Android (Compose)">

```kotlin
// File: core/config/FeatureFlagManager.kt
package com.enterprise.mobile.core.config

import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow

enum class FeatureKey(val keyString: String, val defaultValue: Boolean) {
  NEW_USER_PROFILE_UI("feature_new_profile_ui", false),
  BIOMETRIC_AUTH("feature_biometric_auth", true)
}

@Singleton
class FeatureFlagManager @Inject constructor() {
  private val _flags = MutableStateFlow<Map<FeatureKey, Boolean>>(
    FeatureKey.values().associateWith { it.defaultValue }
  )
  val flags: StateFlow<Map<FeatureKey, Boolean>> = _flags.asStateFlow()

  fun isFeatureEnabled(key: FeatureKey): Boolean {
    return _flags.value[key] ?: key.defaultValue
  }

  suspend fun fetchLatestRemoteFlags() {
    // Simulated remote config fetch & local cache update
    val remoteMap = mapOf(
      FeatureKey.NEW_USER_PROFILE_UI to true,
      FeatureKey.BIOMETRIC_AUTH to true
    )
    _flags.value = remoteMap
  }
}
```

  </TabItem>
