// File: src/core/config/useFeatureFlags.ts
import { useState, useEffect, useCallback } from 'react';

export enum FeatureKey {
  NEW_USER_PROFILE_UI = 'feature_new_profile_ui',
  BIOMETRIC_AUTH = 'feature_biometric_auth',
}

const DEFAULT_FLAGS: Record<FeatureKey, boolean> = {
  [FeatureKey.NEW_USER_PROFILE_UI]: false,
  [FeatureKey.BIOMETRIC_AUTH]: true,
};

export const useFeatureFlags = () => {
  const [flags, setFlags] = useState<Record<FeatureKey, boolean>>(DEFAULT_FLAGS);

  const isEnabled = useCallback(
    (key: FeatureKey): boolean => flags[key] ?? DEFAULT_FLAGS[key],
    [flags]
  );

  const fetchRemoteFlags = useCallback(async () => {
    try {
      // Remote config fetch simulation
      const remote = {
        [FeatureKey.NEW_USER_PROFILE_UI]: true,
        [FeatureKey.BIOMETRIC_AUTH]: true,
      };
      setFlags(remote);
    } catch {
      // Retain fallback defaults on network error
    }
  }, []);

  useEffect(() => {
    fetchRemoteFlags();
  }, [fetchRemoteFlags]);

  return { isEnabled, fetchRemoteFlags };
};
