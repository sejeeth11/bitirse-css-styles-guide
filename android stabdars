## 3. Complete All-in-One TypeScript Specification File

Below is the complete, self-contained **all-in-one TypeScript file** (`UserProfileFeature.tsx`). It contains the entire stack in one place: DTOs, Mappers, Repository Implementation, Domain UseCase, Custom ViewModel Hook, and React Native Styled Screen.

```tsx
// File: src/features/user/UserProfileFeature.tsx
import React, { useEffect, useState, useCallback } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ActivityIndicator,
  TouchableOpacity,
  SafeAreaView,
  StatusBar,
} from 'react-native';

// ============================================================================
// 1. DATA LAYER (DTOs, Mappers & Repository)
// ============================================================================

/** Network Data Transfer Object from API */
export interface UserNetworkDto {
  id: string;
  full_name: string;
  email: string;
  is_vip: boolean;
}

/** Local Storage Schema */
export interface UserCacheEntity {
  id: string;
  fullName: string;
  email: string;
  isVip: boolean;
  cachedAt: number;
}

/** Explicit Mapper Functions */
export const mapDtoToDomain = (dto: UserNetworkDto): UserDomainModel => ({
  id: dto.id,
  name: dto.full_name,
  email: dto.email,
  isVip: dto.is_vip,
});

export const mapCacheToDomain = (cache: UserCacheEntity): UserDomainModel => ({
  id: cache.id,
  name: cache.fullName,
  email: cache.email,
  isVip: cache.isVip,
});

export interface UserRepositoryContract {
  getUserProfile(userId: string): Promise<UserDomainModel>;
}

/** Single Source of Truth Repository */
export class UserRepositoryImpl implements UserRepositoryContract {
  private memoryCache: Map<string, UserDomainModel> = new Map();

  async getUserProfile(userId: string): Promise<UserDomainModel> {
    // Check in-memory fast cache first
    if (this.memoryCache.has(userId)) {
      return this.memoryCache.get(userId)!;
    }

    try {
      // Remote API call
      const response = await fetch(`https://api.example.com/v1/users/${userId}`);
      if (!response.ok) {
        throw new Error(`HTTP error status: ${response.status}`);
      }
      const dto: UserNetworkDto = await response.json();
      const domainModel = mapDtoToDomain(dto);

      // Save to memory cache
      this.memoryCache.set(userId, domainModel);
      return domainModel;
    } catch (error) {
      // Fallback or rethrow domain error
      throw new Error(
        error instanceof Error ? error.message : 'Failed to fetch user profile from network.'
      );
    }
  }
}

// Instantiate Singleton Repository
export const userRepository = new UserRepositoryImpl();

// ============================================================================
// 2. DOMAIN LAYER (Pure Business Models & Use Cases)
// ============================================================================

export interface UserDomainModel {
  id: string;
  name: string;
  email: string;
  isVip: boolean;
}

export class GetUserProfileUseCase {
  constructor(private repository: UserRepositoryContract) {}

  async execute(userId: string): Promise<UserDomainModel> {
    if (!userId || userId.trim().length === 0) {
      throw new Error('User ID cannot be empty.');
    }
    return this.repository.getUserProfile(userId);
  }
}

export const getUserProfileUseCase = new GetUserProfileUseCase(userRepository);

// ============================================================================
// 3. VIEWMODEL / CONTROLLER HOOK LAYER (MVVM + State Management)
// ============================================================================

export type UserProfileUiState =
  | { kind: 'loading' }
  | { kind: 'success'; user: UserDomainModel }
  | { kind: 'error'; message: string };

/** Custom React Hook acting as ViewModel */
export const useUserProfileViewModel = (userId: string) => {
  const [uiState, setUiState] = useState<UserProfileUiState>({ kind: 'loading' });

  const fetchProfile = useCallback(async () => {
    setUiState({ kind: 'loading' });
    try {
      const user = await getUserProfileUseCase.execute(userId);
      setUiState({ kind: 'success', user });
    } catch (err) {
      setUiState({
        kind: 'error',
        message: err instanceof Error ? err.message : 'An unknown error occurred.',
      });
    }
  }, [userId]);

  useEffect(() => {
    fetchProfile();
  }, [fetchProfile]);

  return {
    uiState,
    refreshProfile: fetchProfile,
  };
};

// ============================================================================
// 4. UI LAYER (Stateless React Native Screen & Styled Components)
// ============================================================================

const BRAND_GREEN = '#008544';

export interface UserProfileScreenProps {
  userId: string;
  onNavigateBack?: () => void;
}

export const UserProfileScreen: React.FC<UserProfileScreenProps> = ({
  userId,
  onNavigateBack,
}) => {
  const { uiState, refreshProfile } = useUserProfileViewModel(userId);

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="dark-content" />
      
      {/* Top Header */}
      <View style={styles.header}>
        {onNavigateBack && (
          <TouchableOpacity onPress={onNavigateBack} style={styles.backButton}>
            <Text style={styles.backText}>‹ Back</Text>
          </TouchableOpacity>
        )}
        <Text style={styles.headerTitle}>User Profile</Text>
      </View>

      {/* State View Rendering */}
      <View style={styles.container}>
        {uiState.kind === 'loading' && (
          <View style={styles.centerContainer}>
            <ActivityIndicator size="large" color={BRAND_GREEN} />
            <Text style={styles.loadingText}>Loading profile...</Text>
          </View>
        )}

        {uiState.kind === 'error' && (
          <View style={styles.centerContainer}>
            <Text style={styles.errorText}>{uiState.message}</Text>
            <TouchableOpacity style={styles.retryButton} onPress={refreshProfile}>
              <Text style={styles.retryButtonText}>Retry</Text>
            </TouchableOpacity>
          </View>
        )}

        {uiState.kind === 'success' && (
          <View style={styles.contentContainer}>
            <Text style={styles.userName}>{uiState.user.name}</Text>
            <Text style={styles.userEmail}>{uiState.user.email}</Text>

            {uiState.user.isVip && (
              <View style={styles.vipBadge}>
                <Text style={styles.vipText}>VIP Enterprise Account</Text>
              </View>
            )}

            <View style={styles.spacer} />

            <TouchableOpacity style={styles.refreshButton} onPress={refreshProfile}>
              <Text style={styles.refreshButtonText}>Refresh Profile</Text>
            </TouchableOpacity>
          </View>
        )}
      </View>
    </SafeAreaView>
  );
};

// ============================================================================
// 5. STYLES (Clean Encapsulated StyleSheet)
// ============================================================================

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#F9FAFB',
  },
  header: {
    height: 56,
    flexDirection: 'row',
