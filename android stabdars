## 3. Custom Font Loading & Dynamic Type Scaling

Custom typography must scale naturally with device accessibility text settings (Android Font Scale / iOS Dynamic Type).

<Tabs>
  <TabItem label="Android (Compose)">

```kotlin
// File: core/designsystem/theme/Type.kt
package com.enterprise.mobile.core.designsystem.theme

import androidx.compose.material3.Typography
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.Font
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.sp
import com.enterprise.mobile.core.designsystem.R

// Font Family Definition
val EnterpriseFontFamily = FontFamily(
    Font(R.font.enterprise_sans_regular, FontWeight.Normal),
    Font(R.font.enterprise_sans_medium, FontWeight.Medium),
    Font(R.font.enterprise_sans_bold, FontWeight.Bold)
)

val EnterpriseTypography = Typography(
    headlineLarge = TextStyle(
        fontFamily = EnterpriseFontFamily,
        fontWeight = FontWeight.Bold,
        fontSize = 32.sp,
        lineHeight = 40.sp
    ),
    bodyMedium = TextStyle(
        fontFamily = EnterpriseFontFamily,
        fontWeight = FontWeight.Normal,
        fontSize = 16.sp,
        lineHeight = 24.sp
    )
)
```

  </TabItem>
  <TabItem label="iOS (SwiftUI)">

```swift
// File: Core/DesignSystem/Theme/Typography.swift
import SwiftUI

public extension Font {
    static func enterpriseHeadlineLarge() -> Font {
        return Font.custom("EnterpriseSans-Bold", size: 32, relativeTo: .largeTitle)
    }

    static func enterpriseBodyMedium() -> Font {
        return Font.custom("EnterpriseSans-Regular", size: 16, relativeTo: .body)
    }
}

// Custom Font Registration helper
public struct FontRegistrar {
    public static func registerFonts() {
        guard let fontURL = Bundle.main.url(forResource: "EnterpriseSans-Bold", withExtension: "ttf"),
              let fontDataProvider = CGDataProvider(url: fontURL as CFURL),
              let font = CGFont(fontDataProvider) else { return }
        CTFontManagerRegisterGraphicsFont(font, nil)
    }
}
```

