// File: Core/Config/FeatureFlagManager.swift
import Foundation
import Observation

public enum FeatureKey: String, CaseIterable, Sendable {
    case newUserProfileUI = "feature_new_profile_ui"
    case biometricAuth = "feature_biometric_auth"

    var defaultValue: Bool {
        switch self {
        case .newUserProfileUI: return false
        case .biometricAuth: return true
        }
    }
}

@Observable
@MainActor
public final class FeatureFlagManager {
    public private(set) var flagStates: [FeatureKey: Bool] = [:]

    public init() {
        for key in FeatureKey.allCases {
            flagStates[key] = key.defaultValue
        }
    }

    public func isEnabled(_ key: FeatureKey) -> Bool {
        return flagStates[key] ?? key.defaultValue
    }

    public func fetchRemoteFlags() async {
        // Fetch from Remote Config & update MainActor state
        flagStates[.newUserProfileUI] = true
    }
}
