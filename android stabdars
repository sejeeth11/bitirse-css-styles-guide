// File: Core/Config/AppConfig.swift
import Foundation

public enum EnvironmentType: String {
    case dev
    case staging
    case prod
}

public struct AppConfig: Sendable {
    public let environment: EnvironmentType
    public let apiBaseUrl: URL
    public let connectTimeout: TimeInterval
    public let enableVerboseLogging: Bool

    public static let current: AppConfig = {
        #if DEBUG
        let env = EnvironmentType.dev
        let urlString = "https://api-dev.example.com"
        #elseif STAGING
        let env = EnvironmentType.staging
        let urlString = "https://api-staging.example.com"
        #else
        let env = EnvironmentType.prod
        let urlString = "https://api.example.com"
        #endif

        return AppConfig(
            environment: env,
            apiBaseUrl: URL(string: urlString)!,
            connectTimeout: 30.0,
            enableVerboseLogging: env != .prod
        )
    }()
}
