---
// src/components/mobile/SdkCatalog.astro

// Dynamically import all .md files in the project
const importedMdFiles = import.meta.glob('/src/**/*.{md,mdx}', { eager: true, query: '?raw' });

function getMdContentFromFile(fileKey: string) {
  if (!fileKey) return null;
  for (const [path, contentObj] of Object.entries(importedMdFiles)) {
    if (path.endsWith(fileKey) || path.includes(fileKey)) {
      return typeof contentObj === 'string' ? contentObj : (contentObj as any).default;
    }
  }
  return null;
}

const defaultSdks = [
  {
    "id": "auth-sdk",
    "name": "Auth & Identity SDK",
    "version": "v2.4.0",
    "description": "OAuth 2.0 / OIDC user login, PKCE flow, biometric key storage, and automated JWT token refresh.",
    "platforms": ["android", "ios", "react-native"],
    "installation": {
      "android": { "title": "Android (Gradle)", "mdFile": "android/auth-sdk.md" },
      "ios": { "title": "iOS (Podfile)", "mdFile": "ios/auth-sdk.md" },
      "react-native": { "title": "React Native (npm)", "mdFile": "react-native/auth-sdk.md" }
    }
  }
];

const { sdks = defaultSdks } = Astro.props;

const processedSdks = sdks.map((sdk: any) => {
  if (!sdk.installation) return sdk;
  const newInstallation: Record<string, any> = {};
  
  Object.keys(sdk.installation).forEach((platformKey) => {
    const item = sdk.installation[platformKey];
    let content = item.mdContent;
    
    if (item.mdFile || item.mdPath) {
      const resolved = getMdContentFromFile(item.mdFile || item.mdPath);
      if (resolved) content = resolved;
    }
    
    newInstallation[platformKey] = {
      ...item,
      mdContent: content || item.code || ''
    };
  });

  return { ...sdk, installation: newInstallation };
});
---

<div class="sdk-catalog-container">

  <!-- Platform Filter Bar (100% Pure SVG Icons, 0 Emojis) -->
  <div class="sdk-filter-bar">
    <span class="filter-label">Filter Platform:</span>
    <button class="sdk-filter-btn active" data-filter="all">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      All SDKs ({processedSdks ? processedSdks.length : 0})
    </button>
    <button class="sdk-filter-btn" data-filter="android">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.594 8.2727 13.854 7.848 12 7.848c-1.854 0-3.594.4247-5.1367 1.1017L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.688 11.2386.35 14.659.006 18.72h23.988c-.344-4.061-2.682-7.4814-6.1125-9.3986z"/></svg>
      Android
    </button>
    <button class="sdk-filter-btn" data-filter="ios">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.66-.8 1.11-1.92.99-3.04-0.96.04-2.12.64-2.81 1.44-.61.71-1.15 1.85-1.01 2.95 1.08.08 2.18-.55 2.83-1.35z"/></svg>
      iOS
    </button>
    <button class="sdk-filter-btn" data-filter="react-native">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="9" ry="3"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(120 12 12)"/></svg>
      React Native
    </button>
  </div>

  <!-- 3-Column Card Grid -->
  <div class="sdk-grid">
    {processedSdks && processedSdks.map((sdk: any) => (
      <div class="sdk-card" data-sdk-id={sdk.id} data-platforms={sdk.platforms ? sdk.platforms.join(' ') : ''}>
        <div class="sdk-card-top">
          <div class="sdk-card-header">
            <h3 class="sdk-title">{sdk.name}</h3>
            <span class="sdk-version">{sdk.version}</span>
          </div>
          <p class="sdk-desc">{sdk.description}</p>
          <div class="sdk-badges">
            {sdk.platforms && sdk.platforms.includes('android') && (
              <span class="sdk-badge android"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.594 8.2727 13.854 7.848 12 7.848c-1.854 0-3.594.4247-5.1367 1.1017L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.688 11.2386.35 14.659.006 18.72h23.988c-.344-4.061-2.682-7.4814-6.1125-9.3986z"/></svg>Android</span>
            )}
            {sdk.platforms && sdk.platforms.includes('ios') && (
              <span class="sdk-badge ios"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.66-.8 1.11-1.92.99-3.04-0.96.04-2.12.64-2.81 1.44-.61.71-1.15 1.85-1.01 2.95 1.08.08 2.18-.55 2.83-1.35z"/></svg>iOS</span>
            )}
            {sdk.platforms && sdk.platforms.includes('react-native') && (
              <span class="sdk-badge rn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="9" ry="3"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(120 12 12)"/></svg>React Native</span>
            )}
          </div>
        </div>

        <!-- Inline Accordion Trigger Button -->
        <button class="sdk-btn-accordion" aria-expanded="false">
          <span class="btn-text">Expand Installation Setup</span>
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <!-- Inline Expandable Drawer Panel -->
        <div class="sdk-inline-drawer">
          <!-- STICKY PLATFORM TABS BAR (NEVER SCROLLS) -->
          <div class="drawer-tabs">
            {sdk.installation && Object.keys(sdk.installation).map((platformKey: string, idx: number) => {
              const item = sdk.installation[platformKey];
              return (
                <button class={`drawer-tab-btn ${idx === 0 ? 'active' : ''}`} data-tab-key={platformKey}>
                  {item.title || platformKey.toUpperCase()}
                </button>
              );
            })}
          </div>

          <!-- ONLY THE DRAWER BODY SCROLLS UNDER TABS -->
          <div class="drawer-body">
            {sdk.installation && Object.keys(sdk.installation).map((platformKey: string, idx: number) => {
              const item = sdk.installation[platformKey];
              return (
                <div class={`drawer-pane pane-${platformKey}`} style={idx === 0 ? 'display: block;' : 'display: none;'}>
                  {item.mdContent ? (
                    <div class="md-rendered-content" data-raw-md={item.mdContent}></div>
                  ) : (
                    <div>
                      {item.notes && <div class="sdk-note-callout">💡 <strong>Prerequisite Note:</strong> {item.notes}</div>}
                      <div class="sdk-code-block">
                        <div class="sdk-code-header">
                          <span>code</span>
                          <button class="sdk-copy-btn">Copy</button>
                        </div>
                        <pre><code>{item.code}</code></pre>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    ))}
  </div>

</div>

<script>
  (function() {
    function parseMarkdown(md) {
      if (!md) return '';
      let normalizedMd = md.replace(/\r\n/g, '\n');
      
      let html = normalizedMd
        .replace(/```(\w*)\n([\s\S]*?)```/g, function(match, lang, code) {
          const escapedCode = escapeHtml(code.trim());
          const displayLang = lang || 'code';
          return `<div class="sdk-code-block">
            <div class="sdk-code-header">
              <span>${displayLang}</span>
              <button class="sdk-copy-btn" onclick="navigator.clipboard.writeText(this.parentNode.nextElementSibling.innerText);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">Copy</button>
            </div>
            <pre><code class="language-${displayLang}">${escapedCode}</code></pre>
          </div>`;
        })
        .replace(/^### (.*$)/gim, '<h4>$1</h4>')
        .replace(/^## (.*$)/gim, '<h3>$1</h3>')
        .replace(/^# (.*$)/gim, '<h2>$1</h2>')
        .replace(/^> \[!NOTE\]\s*(.*$)/gim, '<div class="sdk-note-callout">💡 <strong>Note:</strong> $1</div>')
        .replace(/^> \[!WARNING\]\s*(.*$)/gim, '<div class="sdk-warning-callout">⚠️ <strong>Warning:</strong> $1</div>')
        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/^\* (.*$)/gim, '<ul><li>$1</li></ul>')
        .replace(/^\- (.*$)/gim, '<ul><li>$1</li></ul>')
        .replace(/<\/ul>\s*<ul>/g, '')
        .replace(/\n\n/g, '<br/>');

      return `<div class="md-rendered-content">${html}</div>`;
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function renderAllMarkdownElements() {
      document.querySelectorAll('.md-rendered-content[data-raw-md]').forEach(el => {
        if (el.getAttribute('data-rendered') === 'true') return;
        const rawMd = el.getAttribute('data-raw-md') || '';
        el.innerHTML = parseMarkdown(rawMd);
        el.setAttribute('data-rendered', 'true');
      });
    }

    function setupAccordionListeners() {
      renderAllMarkdownElements();

      document.addEventListener('click', (e) => {
        // 1. Filter Buttons
        const filterBtn = e.target.closest('.sdk-filter-btn');
        if (filterBtn) {
          document.querySelectorAll('.sdk-filter-btn').forEach(b => b.classList.remove('active'));
          filterBtn.classList.add('active');
          const filter = filterBtn.getAttribute('data-filter');

          document.querySelectorAll('.sdk-card').forEach(card => {
            const platforms = (card.getAttribute('data-platforms') || '').split(' ');
            if (filter === 'all' || platforms.includes(filter)) {
              card.style.setProperty('display', 'flex', 'important');
            } else {
              card.style.setProperty('display', 'none', 'important');
            }
          });
          return;
        }

        // 2. Inline Accordion Toggle
        const accordionBtn = e.target.closest('.sdk-btn-accordion');
        if (accordionBtn) {
          const card = accordionBtn.closest('.sdk-card');
          if (!card) return;
          const isExpanded = card.classList.contains('expanded');
          
          if (isExpanded) {
            card.classList.remove('expanded');
            accordionBtn.setAttribute('aria-expanded', 'false');
            accordionBtn.querySelector('.btn-text').textContent = 'Expand Installation Setup';
          } else {
            card.classList.add('expanded');
            accordionBtn.setAttribute('aria-expanded', 'true');
            accordionBtn.querySelector('.btn-text').textContent = 'Collapse Setup Guide';
          }
          return;
        }

        // 3. Drawer Platform Tabs Switcher
        const tabBtn = e.target.closest('.drawer-tab-btn');
        if (tabBtn) {
          const card = tabBtn.closest('.sdk-card');
          if (!card) return;
          const tabKey = tabBtn.getAttribute('data-tab-key');

          card.querySelectorAll('.drawer-tab-btn').forEach(b => b.classList.remove('active'));
          tabBtn.classList.add('active');

          card.querySelectorAll('.drawer-pane').forEach(pane => {
            pane.style.display = 'none';
          });
          const targetPane = card.querySelector(`.pane-${tabKey}`);
          if (targetPane) targetPane.style.display = 'block';
          return;
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAccordionListeners);
    } else {
      setupAccordionListeners();
    }
    document.addEventListener('astro:page-load', setupAccordionListeners);
  })();
</script>

<style is:global>
  :root {
    --cargill-green: #008544;
    --cargill-green-hover: #006b37;
    --sdk-bg: #ffffff;
    --sdk-surface: #f2fbf5;
    --sdk-border: #bbf7d0;
    --sdk-text: #052e16;
    --sdk-text-muted: #166534;
    --sdk-code-bg: #052014;
    --sdk-card-shadow: 0 4px 14px rgba(0, 133, 68, 0.08);
    --sdk-card-hover-shadow: 0 10px 25px rgba(0, 133, 68, 0.18);
  }

  :root[data-theme='dark'], [data-theme='dark'] {
    --sdk-bg: #041c10;
    --sdk-surface: #0a2e1c;
    --sdk-border: #14532d;
    --sdk-text: #f0fdf4;
    --sdk-text-muted: #86efac;
    --sdk-code-bg: #02140b;
    --sdk-card-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    --sdk-card-hover-shadow: 0 10px 25px rgba(0, 133, 68, 0.3);
  }

  .sdk-catalog-container { margin: 1.5rem 0 3rem 0; }

  /* Filter Bar */
  .sdk-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .filter-label { font-weight: 600; font-size: 0.9rem; margin-right: 0.5rem; color: var(--sdk-text); }
  .sdk-filter-btn {
    background: var(--sdk-surface);
    border: 1px solid var(--sdk-border);
    color: var(--sdk-text);
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }
  .sdk-filter-btn.active {
    background: var(--cargill-green);
    color: #ffffff;
    border-color: var(--cargill-green);
  }

  /* 3-COLUMN GRID */
  .sdk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 1024px) { .sdk-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .sdk-grid { grid-template-columns: 1fr; } }

  /* CARD STYLING */
  .sdk-card {
    background: var(--sdk-surface);
    border: 1px solid var(--sdk-border);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sdk-card-shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .sdk-card:hover {
    border-color: var(--cargill-green);
    box-shadow: var(--sdk-card-hover-shadow);
  }

  .sdk-card-top {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .sdk-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .sdk-title { font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--sdk-text); }
  .sdk-version {
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--cargill-green);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .sdk-desc {
    font-size: 0.88rem;
    color: var(--sdk-text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.9em;
  }

  .sdk-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    min-height: 28px;
    align-items: center;
  }
  .sdk-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .sdk-badge.android { background: rgba(34, 197, 94, 0.15); color: #15803d; border: 1px solid rgba(34, 197, 94, 0.4); }
  .sdk-badge.ios { background: rgba(59, 130, 246, 0.15); color: #1d4ed8; border: 1px solid rgba(59, 130, 246, 0.4); }
  .sdk-badge.rn { background: rgba(56, 189, 248, 0.15); color: #0369a1; border: 1px solid rgba(56, 189, 248, 0.4); }

  /* INLINE ACCORDION BUTTON */
  .sdk-btn-accordion {
    width: 100%;
    background: var(--cargill-green);
    color: #ffffff;
    border: none;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.2s ease;
    margin-top: auto;
  }
  .sdk-btn-accordion:hover { background: var(--cargill-green-hover); }
  .sdk-btn-accordion .chevron-icon { transition: transform 0.3s ease; }
  .sdk-card.expanded .sdk-btn-accordion .chevron-icon { transform: rotate(180deg); }

  /* FLEX CONTAINER FOR INLINE DRAWER (PREVENTS TAB OVERLAP & LEAKAGE) */
  .sdk-inline-drawer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
    opacity: 0;
    margin-top: 0;
    border-top: 0 solid var(--sdk-border);
    display: flex;
    flex-direction: column;
  }
  .sdk-card.expanded .sdk-inline-drawer {
    max-height: 480px;
    opacity: 1;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sdk-border);
  }

  /* STICKY PLATFORM TABS BAR (FIXED AT TOP OF DRAWER, NEVER SCROLLS) */
  .drawer-tabs {
    display: flex;
    gap: 0.35rem;
    border-bottom: 2px solid var(--sdk-border);
    margin-bottom: 0.75rem;
    background: var(--sdk-surface);
    flex-shrink: 0;
    z-index: 5;
  }
  .drawer-tab-btn {
    background: none;
    border: none;
    padding: 0.45rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sdk-text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }
  .drawer-tab-btn:hover { color: var(--cargill-green); }
  .drawer-tab-btn.active {
    color: var(--cargill-green);
    border-bottom-color: var(--cargill-green);
    background: rgba(0, 133, 68, 0.08);
    border-radius: 4px 4px 0 0;
  }

  /* DRAWER BODY (ONLY THE BODY SCROLLS UNDER TABS) */
  .drawer-body {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--sdk-text);
    overflow-y: auto;
    flex-grow: 1;
    padding-right: 0.4rem;
  }

  /* CUSTOM CARGILL SCROLLBAR ON BODY */
  .drawer-body::-webkit-scrollbar { width: 6px; }
  .drawer-body::-webkit-scrollbar-track { background: rgba(0, 133, 68, 0.05); border-radius: 4px; }
  .drawer-body::-webkit-scrollbar-thumb { background: var(--cargill-green); border-radius: 4px; }
  .drawer-body::-webkit-scrollbar-thumb:hover { background: var(--cargill-green-hover); }

  .md-rendered-content h4 { margin: 0.6rem 0 0.3rem 0; font-size: 0.9rem; color: var(--sdk-text); }
  .md-rendered-content ul { padding-left: 1.2rem; margin: 0.4rem 0 0.8rem 0; }
  .md-rendered-content li { margin-bottom: 0.2rem; }
  
  .sdk-note-callout {
    background: rgba(0, 133, 68, 0.1);
    border-left: 3px solid var(--cargill-green);
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    margin: 0.5rem 0;
    font-size: 0.8rem;
    color: var(--sdk-text);
  }
  .sdk-warning-callout {
    background: rgba(234, 179, 8, 0.1);
    border-left: 3px solid #d97706;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    margin: 0.5rem 0;
    font-size: 0.8rem;
    color: var(--sdk-text);
  }

