---
// src/components/mobile/SdkCatalog.astro

const importedMdFiles = import.meta.glob('/src/**/*.{md,mdx}', { eager: true, query: '?raw' });

function getMdContentFromFile(fileKey: string) {
  if (!fileKey) return null;
  for (const [path, contentObj] of Object.entries(importedMdFiles)) {
    if (path.endsWith(fileKey) || path.includes(fileKey)) {
      return typeof contentObj === 'string' ? contentObj : (contentObj as any).default;
    }
  }
  return null;
}

const defaultSdks = [
  {
    "id": "ui-kit",
    "name": "Design System UI Kit",
    "version": "v3.1.0",
    "description": "Standardized buttons, input fields, modals, design tokens, dark mode support, and WCAG AA accessibility.",
    "platforms": ["android", "ios", "react-native"],
    "installation": {
      "android": { "title": "Android (Compose)", "mdFile": "ui-kit-android.md" },
      "ios": { "title": "iOS (SwiftUI)", "mdFile": "ui-kit-ios.md" },
      "react-native": { "title": "React Native (npm)", "mdFile": "ui-kit-rn.md" }
    }
  }
];

const { sdks = defaultSdks } = Astro.props;

const processedSdks = sdks.map((sdk: any) => {
  if (!sdk.installation) return sdk;
  const newInstallation: Record<string, any> = {};
  
  Object.keys(sdk.installation).forEach((platformKey) => {
    const item = sdk.installation[platformKey];
    let content = item.mdContent;
    
    if (item.mdFile || item.mdPath) {
      const resolved = getMdContentFromFile(item.mdFile || item.mdPath);
      if (resolved) content = resolved;
    }
    
    newInstallation[platformKey] = {
      ...item,
      mdContent: content || item.code || ''
    };
  });

  return { ...sdk, installation: newInstallation };
});
---

<div class="sdk-catalog-container">
  <div class="sdk-filter-bar">
    <span class="filter-label">Filter Platform:</span>
    <button class="sdk-filter-btn active" data-filter="all">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      All SDKs ({processedSdks ? processedSdks.length : 0})
    </button>
    <button class="sdk-filter-btn" data-filter="android">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.594 8.2727 13.854 7.848 12 7.848c-1.854 0-3.594.4247-5.1367 1.1017L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.688 11.2386.35 14.659.006 18.72h23.988c-.344-4.061-2.682-7.4814-6.1125-9.3986z"/></svg>
      Android
    </button>
    <button class="sdk-filter-btn" data-filter="ios">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.66-.8 1.11-1.92.99-3.04-0.96.04-2.12.64-2.81 1.44-.61.71-1.15 1.85-1.01 2.95 1.08.08 2.18-.55 2.83-1.35z"/></svg>
      iOS
    </button>
    <button class="sdk-filter-btn" data-filter="react-native">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="9" ry="3"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(120 12 12)"/></svg>
      React Native
    </button>
  </div>

  <!-- 2-COLUMN RESPONSIVE GRID -->
  <div class="sdk-grid">
    {processedSdks && processedSdks.map((sdk: any) => (
      <div class="sdk-card" data-sdk-id={sdk.id} data-platforms={sdk.platforms ? sdk.platforms.join(' ') : ''}>
        <div class="sdk-card-top">
          <div class="sdk-card-header">
            <h3 class="sdk-title">{sdk.name}</h3>
            <span class="sdk-version">{sdk.version}</span>
          </div>
          <p class="sdk-desc">{sdk.description}</p>
          <div class="sdk-badges">
            {sdk.platforms && sdk.platforms.includes('android') && (
              <span class="sdk-badge android"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.594 8.2727 13.854 7.848 12 7.848c-1.854 0-3.594.4247-5.1367 1.1017L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.688 11.2386.35 14.659.006 18.72h23.988c-.344-4.061-2.682-7.4814-6.1125-9.3986z"/></svg>Android</span>
            )}
            {sdk.platforms && sdk.platforms.includes('ios') && (
              <span class="sdk-badge ios"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.66-.8 1.11-1.92.99-3.04-0.96.04-2.12.64-2.81 1.44-.61.71-1.15 1.85-1.01 2.95 1.08.08 2.18-.55 2.83-1.35z"/></svg>iOS</span>
            )}
            {sdk.platforms && sdk.platforms.includes('react-native') && (
              <span class="sdk-badge rn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="9" ry="3"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(120 12 12)"/></svg>React Native</span>
            )}
          </div>
        </div>

        <button class="sdk-btn-modal-trigger" data-sdk-name={sdk.name} data-sdk-version={sdk.version}>
          <span>View Installation Setup</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </button>

        <!-- Hidden Data Store for Modal Population -->
        <div class="sdk-hidden-installation-data" style="display: none;">
          {sdk.installation && Object.keys(sdk.installation).map((platformKey: string) => {
            const item = sdk.installation[platformKey];
            return (
              <div class="platform-data-item" data-platform-key={platformKey} data-title={item.title || platformKey.toUpperCase()}>
                {item.mdContent ? (
                  <div class="md-raw-content" data-raw-md={item.mdContent}></div>
                ) : (
                  <div>
                    {item.notes && <div class="sdk-note-callout">💡 <strong>Prerequisite Note:</strong> {item.notes}</div>}
                    <div class="sdk-code-block">
                      <div class="sdk-code-header">
                        <span>code</span>
                        <button class="sdk-copy-btn">Copy</button>
                      </div>
                      <pre><code>{item.code}</code></pre>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>

<!-- GLOBAL POPUP MODAL DIALOG OVERLAY -->
<div id="sdkModalOverlay" class="sdk-modal-overlay">
  <div class="sdk-modal-container">
    <div class="sdk-modal-header">
      <div class="sdk-modal-title-group">
        <h2 id="modalTitle" class="sdk-modal-title">SDK Installation</h2>
        <span id="modalVersion" class="sdk-version">v1.0.0</span>
      </div>
      <button id="modalCloseBtn" class="sdk-modal-close-btn" aria-label="Close modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div id="modalTabsBar" class="sdk-modal-tabs"></div>
    <div id="modalBodyContent" class="sdk-modal-body"></div>
  </div>
</div>

<script>
  (function() {
    function parseMarkdown(md) {
      if (!md) return '';
      let normalizedMd = md.replace(/\r\n/g, '\n');
      
      let html = normalizedMd
        .replace(/```(\w*)\n([\s\S]*?)```/g, function(match, lang, code) {
          const escapedCode = escapeHtml(code.trim());
          const displayLang = lang || 'code';
          return `<div class="sdk-code-block">
            <div class="sdk-code-header">
              <span>${displayLang}</span>
              <button class="sdk-copy-btn" onclick="navigator.clipboard.writeText(this.parentNode.nextElementSibling.innerText);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)">Copy</button>
            </div>
            <pre><code class="language-${displayLang}">${escapedCode}</code></pre>
          </div>`;
        })
        .replace(/^### (.*$)/gim, '<h4>$1</h4>')
        .replace(/^## (.*$)/gim, '<h3>$1</h3>')
        .replace(/^# (.*$)/gim, '<h2>$1</h2>')
        .replace(/^> \[!NOTE\]\s*(.*$)/gim, '<div class="sdk-note-callout">💡 <strong>Note:</strong> $1</div>')
        .replace(/^> \[!WARNING\]\s*(.*$)/gim, '<div class="sdk-warning-callout">⚠️ <strong>Warning:</strong> $1</div>')
        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/^\* (.*$)/gim, '<ul><li>$1</li></ul>')
        .replace(/^\- (.*$)/gim, '<ul><li>$1</li></ul>')
        .replace(/<\/ul>\s*<ul>/g, '')
        .replace(/\n\n/g, '<br/>');

      return `<div class="md-rendered-content">${html}</div>`;
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function getPlatformIconSVG(key) {
      if (key === 'android') {
        return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997 0-.551.4482-.9993.9993-.9993.5516 0 .9997.4483.9997.9993 0 .5511-.4481.9997-.9997-.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.594 8.2727 13.854 7.848 12 7.848c-1.854 0-3.594.4247-5.1367 1.1017L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.688 11.2386.35 14.659.006 18.72h23.988c-.344-4.061-2.682-7.4814-6.1125-9.3986z"/></svg>`;
      } else if (key === 'ios') {
        return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.66-.8 1.11-1.92.99-3.04-0.96.04-2.12.64-2.81 1.44-.61.71-1.15 1.85-1.01 2.95 1.08.08 2.18-.55 2.83-1.35z"/></svg>`;
      } else {
        return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="9" ry="3"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3" transform="rotate(120 12 12)"/></svg>`;
      }
    }

    function openModalForCard(card) {
      const modalOverlay = document.getElementById('sdkModalOverlay');
      const modalTitle = document.getElementById('modalTitle');
      const modalVersion = document.getElementById('modalVersion');
      const modalTabsBar = document.getElementById('modalTabsBar');
      const modalBodyContent = document.getElementById('modalBodyContent');

      if (!modalOverlay || !card) return;

      const triggerBtn = card.querySelector('.sdk-btn-modal-trigger');
      const title = triggerBtn ? triggerBtn.getAttribute('data-sdk-name') : 'SDK Installation';
      const version = triggerBtn ? triggerBtn.getAttribute('data-sdk-version') : '';

      modalTitle.textContent = title;
      modalVersion.textContent = version;

      modalTabsBar.innerHTML = '';
      modalBodyContent.innerHTML = '';

      const platformItems = card.querySelectorAll('.platform-data-item');
      
      platformItems.forEach((item, idx) => {
        const platformKey = item.getAttribute('data-platform-key');
        const platformTitle = item.getAttribute('data-title');
        
        // Build tab button
        const tabBtn = document.createElement('button');
        tabBtn.className = `sdk-modal-tab-btn ${idx === 0 ? 'active' : ''}`;
        tabBtn.setAttribute('data-target-platform', platformKey);
        tabBtn.innerHTML = `${getPlatformIconSVG(platformKey)} <span>${platformTitle}</span>`;
        modalTabsBar.appendChild(tabBtn);

        // Build content pane
        const pane = document.createElement('div');
        pane.className = `modal-pane modal-pane-${platformKey}`;
        pane.style.display = idx === 0 ? 'block' : 'none';

        const rawMdEl = item.querySelector('.md-raw-content');
        if (rawMdEl) {
          const rawMd = rawMdEl.getAttribute('data-raw-md') || '';
          pane.innerHTML = parseMarkdown(rawMd);
        } else {
          pane.innerHTML = item.innerHTML;
        }

        modalBodyContent.appendChild(pane);
      });

      modalOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      const modalOverlay = document.getElementById('sdkModalOverlay');
      if (modalOverlay) {
        modalOverlay.classList.remove('active');
      }
      document.body.style.overflow = '';
    }

    function setupCatalogListeners() {
      document.addEventListener('click', (e) => {
        // Platform Filter Click
        const filterBtn = e.target.closest('.sdk-filter-btn');
        if (filterBtn) {
          document.querySelectorAll('.sdk-filter-btn').forEach(b => b.classList.remove('active'));
          filterBtn.classList.add('active');
          const filter = filterBtn.getAttribute('data-filter');

          document.querySelectorAll('.sdk-card').forEach(card => {
            const platforms = (card.getAttribute('data-platforms') || '').split(' ');
            if (filter === 'all' || platforms.includes(filter)) {
              card.style.setProperty('display', 'flex', 'important');
            } else {
              card.style.setProperty('display', 'none', 'important');
            }
          });
          return;
        }

        // Open Modal Trigger Click
        const modalTrigger = e.target.closest('.sdk-btn-modal-trigger');
        if (modalTrigger) {
          const card = modalTrigger.closest('.sdk-card');
          openModalForCard(card);
          return;
        }

        // Close Modal Button Click
        if (e.target.closest('#modalCloseBtn')) {
          closeModal();
          return;
        }

        // Modal Tab Switching Click
        const modalTabBtn = e.target.closest('.sdk-modal-tab-btn');
        if (modalTabBtn) {
          const targetPlatform = modalTabBtn.getAttribute('data-target-platform');
          document.querySelectorAll('.sdk-modal-tab-btn').forEach(b => b.classList.remove('active'));
          modalTabBtn.classList.add('active');

          document.querySelectorAll('.modal-pane').forEach(p => p.style.display = 'none');
          const targetPane = document.querySelector(`.modal-pane-${targetPlatform}`);
          if (targetPane) targetPane.style.display = 'block';
          return;
        }

        // Modal Overlay Backdrop Click
        const modalOverlay = document.getElementById('sdkModalOverlay');
        if (e.target === modalOverlay) {
          closeModal();
          return;
        }
      });

      // Escape key handler
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCatalogListeners);
    } else {
      setupCatalogListeners();
    }
    document.addEventListener('astro:page-load', setupCatalogListeners);
  })();
</script>

<style is:global>
  :root {
    --cargill-green: #008544;
    --cargill-green-hover: #006b37;
    --sdk-bg: #ffffff;
    --sdk-surface: #ffffff;
    --sdk-card-bg: #f2fbf5;
    --sdk-border: #bbf7d0;
    --sdk-text: #052e16;
    --sdk-text-muted: #166534;
    --sdk-code-bg: #052014;
    --sdk-card-shadow: 0 4px 14px rgba(0, 133, 68, 0.08);
    --sdk-card-hover-shadow: 0 10px 25px rgba(0, 133, 68, 0.18);
  }

  :root[data-theme='dark'], [data-theme='dark'] {
    --sdk-bg: #041c10;
    --sdk-surface: #072415;
    --sdk-card-bg: #0a2e1c;
    --sdk-border: #14532d;
    --sdk-text: #f0fdf4;
    --sdk-text-muted: #86efac;
    --sdk-code-bg: #02140b;
    --sdk-card-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    --sdk-card-hover-shadow: 0 10px 25px rgba(0, 133, 68, 0.3);
  }

  .sdk-catalog-container { margin: 1.5rem 0 3rem 0; }
  .sdk-filter-bar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .filter-label { font-weight: 600; font-size: 0.9rem; margin-right: 0.5rem; color: var(--sdk-text); }
  .sdk-filter-btn { background: var(--sdk-card-bg); border: 1px solid var(--sdk-border); color: var(--sdk-text); padding: 0.5rem 1.1rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s ease; }
  .sdk-filter-btn:hover { border-color: var(--cargill-green); }
  .sdk-filter-btn.active { background: var(--cargill-green); color: #ffffff; border-color: var(--cargill-green); }

  /* 2-COLUMN RESPONSIVE GRID */
  .sdk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (max-width: 768px) { .sdk-grid { grid-template-columns: minmax(0, 1fr) !important; } }

  .sdk-card {
    background: var(--sdk-card-bg);
    border: 1px solid var(--sdk-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sdk-card-shadow);
    min-width: 0 !important;
    word-break: break-word;
    overflow-wrap: break-word;
    transition: all 0.2s ease;
  }
  .sdk-card:hover { border-color: var(--cargill-green); box-shadow: var(--sdk-card-hover-shadow); transform: translateY(-2px); }

  .sdk-card-top { display: flex; flex-direction: column; flex-grow: 1; margin-bottom: 1.25rem; }
  .sdk-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem; }
  .sdk-title { font-size: 1.25rem; font-weight: 700; margin: 0; color: var(--sdk-text); }
  .sdk-version { font-size: 0.75rem; font-weight: 700; background: var(--cargill-green); color: #ffffff; padding: 3px 9px; border-radius: 4px; flex-shrink: 0; }

  .sdk-desc { font-size: 0.9rem; color: var(--sdk-text-muted); margin: 0 0 1.25rem 0; line-height: 1.5; }

  .sdk-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; min-height: 28px; align-items: center; }
  .sdk-badge { font-size: 0.75rem; font-weight: 600; padding: 4px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 5px; }
  .sdk-badge.android { background: rgba(34, 197, 94, 0.15); color: #15803d; border: 1px solid rgba(34, 197, 94, 0.4); }
